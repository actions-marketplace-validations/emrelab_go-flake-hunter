From cb87c270b63fb0660d63bea17ba435732822ef49 Mon Sep 17 00:00:00 2001
From: Anant Kumar <antcybersec@users.noreply.github.com>
Date: Wed, 11 Nov 2026 14:56:31 +0530
Subject: [PATCH 1/3] apiserver/cel: stop TestObserve* sharing the global CEL
 histograms

TestObserveCompilation and TestObserveEvaluation observed into the
package-level Metrics and expected a sample count of 1. Their
legacyregistry.Reset() did nothing: Reset only calls Reset() on
registered collectors that have the method, and a plain Histogram does
not, so the samples survived. A second run in the same binary
(go test -count=2) saw count 2 and sum 4.

Let newCelMetrics take the registerer so each test can own a CelMetrics
registered only with its own registry, as other tests under
pkg/storage do with metrics.NewKubeRegistry.

Signed-off-by: anant <170962632+antcybersec@users.noreply.github.com>
---
 .../apiserver/pkg/cel/metrics/metrics.go      | 10 ++++---
 .../apiserver/pkg/cel/metrics/metrics_test.go | 27 ++++++++++++-------
 2 files changed, 23 insertions(+), 14 deletions(-)

diff --git a/staging/src/k8s.io/apiserver/pkg/cel/metrics/metrics.go b/staging/src/k8s.io/apiserver/pkg/cel/metrics/metrics.go
index 02f232c17c201..2fc604693a4d2 100644
--- a/staging/src/k8s.io/apiserver/pkg/cel/metrics/metrics.go
+++ b/staging/src/k8s.io/apiserver/pkg/cel/metrics/metrics.go
@@ -30,14 +30,17 @@ const (
 )
 
 // Metrics provides access to CEL metrics.
-var Metrics = newCelMetrics()
+var Metrics = newCelMetrics(legacyregistry.MustRegister)
 
 type CelMetrics struct {
 	compilationTime *metrics.Histogram
 	evaluationTime  *metrics.Histogram
 }
 
-func newCelMetrics() *CelMetrics {
+// newCelMetrics builds the CEL metrics and hands them to registerer. Tests pass
+// their own registry's MustRegister, because a Histogram keeps its observations
+// for the lifetime of the process and legacyregistry.Reset cannot clear them.
+func newCelMetrics(registerer func(...metrics.Registerable)) *CelMetrics {
 	m := &CelMetrics{
 		compilationTime: metrics.NewHistogram(&metrics.HistogramOpts{
 			Namespace:      namespace,
@@ -55,8 +58,7 @@ func newCelMetrics() *CelMetrics {
 		}),
 	}
 
-	legacyregistry.MustRegister(m.compilationTime)
-	legacyregistry.MustRegister(m.evaluationTime)
+	registerer(m.compilationTime, m.evaluationTime)
 
 	return m
 }
