Subject: [PATCH 1/2] client-go/rest: clean up auth provider plugins registered
 by tests

TestAuthPluginWrapTransport, TestAuthPluginPersist, and
Test_WhenNilPersister_NoOpPersisterIsAssigned registered auth provider
plugins directly into the package-level plugins map and never removed
them, so a second run in the same binary (go test -count=2, or a
-shuffle rerun) failed with 'was registered twice'. Register through a
helper that deletes the entry in t.Cleanup under pluginsLock.

The helper also fixes the error message in TestAuthPluginPersist, which
reported pluginA while registering pluginA2.
---
 .../src/k8s.io/client-go/rest/plugin_test.go  | 40 ++++++++++---------
 1 file changed, 22 insertions(+), 18 deletions(-)

diff --git a/staging/src/k8s.io/client-go/rest/plugin_test.go b/staging/src/k8s.io/client-go/rest/plugin_test.go
index de51967fb8ec5..de93f48ffda85 100644
--- a/staging/src/k8s.io/client-go/rest/plugin_test.go
+++ b/staging/src/k8s.io/client-go/rest/plugin_test.go
@@ -26,16 +26,26 @@ import (
 	clientcmdapi "k8s.io/client-go/tools/clientcmd/api"
 )
 
-func TestAuthPluginWrapTransport(t *testing.T) {
-	if err := RegisterAuthProviderPlugin("pluginA", pluginAProvider); err != nil {
-		t.Errorf("Unexpected error: failed to register pluginA: %v", err)
-	}
-	if err := RegisterAuthProviderPlugin("pluginB", pluginBProvider); err != nil {
-		t.Errorf("Unexpected error: failed to register pluginB: %v", err)
-	}
-	if err := RegisterAuthProviderPlugin("pluginFail", pluginFailProvider); err != nil {
-		t.Errorf("Unexpected error: failed to register pluginFail: %v", err)
+// registerAuthProviderPluginForTest registers a plugin in the package-level
+// registry and removes it again when the test ends. Without the removal a
+// second run in the same binary (go test -count=2, or a -shuffle rerun) fails
+// with "was registered twice".
+func registerAuthProviderPluginForTest(t *testing.T, name string, plugin Factory) {
+	t.Helper()
+	if err := RegisterAuthProviderPlugin(name, plugin); err != nil {
+		t.Fatalf("Unexpected error: failed to register %s: %v", name, err)
 	}
+	t.Cleanup(func() {
+		pluginsLock.Lock()
+		defer pluginsLock.Unlock()
+		delete(plugins, name)
+	})
+}
+
+func TestAuthPluginWrapTransport(t *testing.T) {
+	registerAuthProviderPluginForTest(t, "pluginA", pluginAProvider)
+	registerAuthProviderPluginForTest(t, "pluginB", pluginBProvider)
+	registerAuthProviderPluginForTest(t, "pluginFail", pluginFailProvider)
 	testCases := []struct {
 		useWrapTransport bool
 		plugin           string
@@ -96,12 +106,8 @@ func TestAuthPluginWrapTransport(t *testing.T) {
 
 func TestAuthPluginPersist(t *testing.T) {
 	// register pluginA by a different name so we don't collide across tests.
-	if err := RegisterAuthProviderPlugin("pluginA2", pluginAProvider); err != nil {
-		t.Errorf("Unexpected error: failed to register pluginA: %v", err)
-	}
-	if err := RegisterAuthProviderPlugin("pluginPersist", pluginPersistProvider); err != nil {
-		t.Errorf("Unexpected error: failed to register pluginPersist: %v", err)
-	}
+	registerAuthProviderPluginForTest(t, "pluginA2", pluginAProvider)
+	registerAuthProviderPluginForTest(t, "pluginPersist", pluginPersistProvider)
 	fooBarConfig := map[string]string{"foo": "bar"}
 	testCases := []struct {
 		plugin                       string
@@ -173,9 +179,7 @@ func TestAuthPluginPersist(t *testing.T) {
 
 func Test_WhenNilPersister_NoOpPersisterIsAssigned(t *testing.T) {
 
-	if err := RegisterAuthProviderPlugin("anyPlugin", pluginPersistProvider); err != nil {
-		t.Errorf("unexpected error: failed to register 'anyPlugin': %v", err)
-	}
+	registerAuthProviderPluginForTest(t, "anyPlugin", pluginPersistProvider)
 	cfg := &clientcmdapi.AuthProviderConfig{
 		Name:   "anyPlugin",
 		Config: nil,

From 6a04ce6b91f78b5f565a33c98e88abbf83e8f06c Mon Sep 17 00:00:00 2001
From: Anant Kumar <antcybersec@users.noreply.github.com>
Date: Mon, 19 Oct 2026 20:00:22 +0530
Subject: [PATCH 2/2] client-go/rest: give TestThrottledLogger its own logger

The test swapped globalThrottledLogger.clock and advanced time, but
attemptToLog also records a lastLogTime per setting and that outlived
the test. A second run in the same binary (go test -count=2) compared a
fresh fake clock against the previous run's timeline and threw away
every expected message.

Build a throttledLogger for the test instead of borrowing the global
one, so there is no shared state to restore afterwards. The settings
move into newThrottledLogger so the test still covers the intervals the
global logger runs with.

Signed-off-by: anant <170962632+antcybersec@users.noreply.github.com>
---
 staging/src/k8s.io/client-go/rest/request.go  | 24 +++++++++++--------
 .../src/k8s.io/client-go/rest/request_test.go | 11 ++++-----
 2 files changed, 19 insertions(+), 16 deletions(-)

diff --git a/staging/src/k8s.io/client-go/rest/request.go b/staging/src/k8s.io/client-go/rest/request.go
index fe3c066729a8c..871f770aef6b4 100644
--- a/staging/src/k8s.io/client-go/rest/request.go
+++ b/staging/src/k8s.io/client-go/rest/request.go
@@ -712,19 +712,23 @@ type throttledLogger struct {
 	settings []*throttleSettings
 }
 
-var globalThrottledLogger = &throttledLogger{
-	clock: clock.RealClock{},
-	settings: []*throttleSettings{
-		{
-			logLevel:       2,
-			minLogInterval: 1 * time.Second,
-		}, {
-			logLevel:       0,
-			minLogInterval: 10 * time.Second,
+func newThrottledLogger(c clock.PassiveClock) *throttledLogger {
+	return &throttledLogger{
+		clock: c,
+		settings: []*throttleSettings{
+			{
+				logLevel:       2,
+				minLogInterval: 1 * time.Second,
+			}, {
+				logLevel:       0,
+				minLogInterval: 10 * time.Second,
+			},
 		},
-	},
+	}
 }
 
+var globalThrottledLogger = newThrottledLogger(clock.RealClock{})
+
 func (b *throttledLogger) attemptToLog(logger klog.Logger) (int, bool) {
 	for _, setting := range b.settings {
 		if bool(logger.V(setting.logLevel).Enabled()) {
